{
  "marker": "CODEX_QUALITY_HARNESS_FILE v1.2.8",
  "schemaVersion": "1.2.8",
  "artifactSchemaVersion": "1.0.0",
  "name": "CODEX_V128_CONTRACT_SCHEMA",
  "purpose": "Machine-readable contracts for v1.2.8 deterministic projection, reason, token, and resume semantics.",
  "canonicalJson": {
    "strictParser": true,
    "duplicateKeyReject": true,
    "canonicalization": "RFC8785",
    "digest": "SHA-256",
    "encoding": "UTF-8",
    "digestBeforeDefaultMaterialization": true,
    "unknownReasonFailClosed": true
  },
  "authority": {
    "decisionCapsule": "domain_decision_authority",
    "evidenceCapsule": "same_head_freshness_authority",
    "finalDecision": "pass_block_mergeAllowed_exit_code_authority",
    "qualityGateSafeSummary": "non_authoritative_projection"
  },
  "projection": {
    "activationState": "source_shadow_candidate",
    "activationReady": false,
    "routineBytesMax": 1600,
    "stressBytesMax": 2048,
    "observedProjectionRequiredForActivation": true,
    "placeholderBytesAllowed": false,
    "providerClosurePreclaimAllowed": false,
    "finalDecisionInputAllowed": false,
    "integrityBindingRequired": true,
    "integrityBindingChecks": ["schema", "head", "generator_contract_digest", "projection_input_digest", "projection_payload_digest"],
    "routineReaderIntegrityChecks": ["schema", "head", "projection_payload_digest"],
    "gateIntegrityChecks": ["generator_contract_digest", "projection_input_digest"],
    "artifactDependencyDag": "acyclic"
  },
  "stateMatrix": {
    "executor": "scripts/codex-v128-state-matrix.mjs",
    "coverage": "full_shadow_candidate",
    "axisScope": "declared_three_axis_shadow_matrix",
    "fullEnumProductExecuted": true,
    "expectedCellCount": 96,
    "expectedTransitionCount": 6,
    "expectedHardInvalidCount": 90,
    "implicitTransitionFallbackAllowed": false
  },
  "reason": {
    "states": ["none", "observed", "pending", "missing", "failed", "valid", "invalid", "stale", "blocked"],
    "effects": ["none", "awaiting", "blocking", "advisory", "display_only", "compatibility_shadow"],
    "effectDerivedFromPhase": true
  },
  "tokenEconomy": {
    "routineSelectedSkillMax": 1,
    "mandatorySafetySelectedSkillMax": 2,
    "routineManagedSafeArtifactRead": 1,
    "routineColdArtifactRead": 0,
    "diagnosticColdArtifactReadMax": 3,
    "compiledEffectiveInstructionCapsuleCount": 1,
    "boundedProjectionReader": "scripts/codex-v128-projection-reader.mjs",
    "boundedProjectionReaderSurfaceBytesMax": 1600,
    "boundedProjectionReaderStdoutBytesMax": 1600,
    "boundedProjectionReaderStrictJson": true,
    "managedContextEmitter": "scripts/codex-v128-managed-context-emitter.mjs",
    "perTransitionManagedContextBytesMax": 4096,
    "managedContextBytesObserved": true,
    "managedContextObservationSource": "v128_managed_context_emitter",
    "managedContextObservationScope": "source_shadow_candidate",
    "managedContextObservationRequiredForActivation": true,
    "routineFinalReportLineMax": 8,
    "routineOwnerInterruptMax": 0,
    "repeatedSafetyTextMax": 0
  },
  "validationExecution": {
    "storage": "codex-orchestration-capsule.safe.json",
    "newP0ArtifactAllowed": false,
    "profileDagRequired": true,
    "nodeExecutionMaxPerRun": 1,
    "finalizerMode": "aggregate_only",
    "downstreamCommandRespawnAllowed": false,
    "downstreamReadsTypedResult": true,
    "upstreamMissingReason": "upstream_evidence_missing",
    "cacheKeyFields": [
      "headSha",
      "planDigest",
      "scriptDigest",
      "lockfileDigest",
      "runnerImageDigest",
      "runtimeVersion",
      "taskProfile",
      "environmentClass"
    ],
    "cacheKeyPlaceholderValuesForbidden": ["", "unknown", "required", "null", "undefined", "placeholder"],
    "reuseDecisions": ["hit", "partial_hit", "miss"],
    "reuseReportMustListSkippedNodes": true
  },
  "stableDiagnosticTaxonomy": {
    "classes": ["decision_stable", "cache_stable", "environment_diagnostic", "owner_input", "forbidden"],
    "environmentDiagnosticInDecisionDigestAllowed": false,
    "rawLogAllowed": false,
    "secretAllowed": false,
    "localAbsolutePathRemoteArtifactAllowed": false
  },
  "permission": {
    "projectionCreatesPermission": false,
    "permissionDerivedFromCurrentReceiptWhenHydrated": true,
    "missingReceiptState": "not_available",
    "placeholderReceiptValid": false,
    "allowedContinuationActions": ["edit", "check", "commit", "push", "create_pr", "rerun_ci", "fix_ci"],
    "ownerBoundaryActions": ["merge", "scope_expand", "product_runtime", "deploy", "wallet_rpc"]
  },
  "checkpoint": {
    "authority": "non_authoritative_resume_assist",
    "requiredBindings": [
      "headOid",
      "scopeContractDigest",
      "processReceiptDigest",
      "lastVerifiedEvidenceDigest",
      "workerId",
      "worktreeId",
      "checkpointSequence",
      "previousCheckpointDigest"
    ],
    "networkFilesystemAutoResumeAllowed": false
  },
  "workspaceIdentity": {
    "remoteSafeArtifactFields": [
      "repositoryKey",
      "remoteDigest",
      "branch",
      "headSha",
      "activeHarnessVersion",
      "worktreeIdentityDigest",
      "canonicalityState"
    ],
    "canonicalityStates": ["canonical", "duplicate_candidate", "repo_mismatch", "harness_version_mismatch", "unknown"],
    "rawWorkspacePathRemoteArtifactAllowed": false
  },
  "safeSummaryOnly": true
}
