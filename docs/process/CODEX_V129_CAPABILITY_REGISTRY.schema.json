{
  "schemaVersion": "1.2.9",
  "title": "CODEX v1.2.9 Protected Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "capabilities", "plugins", "routes"],
  "properties": {
    "schemaVersion": { "const": "1.2.9" },
    "registryId": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityClass", "resolvedModelRef", "maxOutputBytes"],
        "properties": {
          "capabilityClass": { "type": "string" },
          "resolvedModelRef": { "type": "string" },
          "maxOutputBytes": { "type": "integer", "minimum": 1 },
          "fallbackChain": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginId", "authorizedTaskClasses"],
        "properties": {
          "pluginId": { "type": "string" },
          "authorizedTaskClasses": { "type": "array", "items": { "type": "string" } },
          "requiresDefensiveScope": { "type": "boolean" }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requiredCapabilityClasses", "pluginDefault"],
        "properties": {
          "requiredCapabilityClasses": { "type": "array", "items": { "type": "string" } },
          "pluginDefault": { "type": "string" },
          "eligiblePlugins": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
